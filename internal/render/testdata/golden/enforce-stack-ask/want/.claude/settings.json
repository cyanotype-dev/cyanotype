{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "PowerShell(pnpm *)",
      "PowerShell(yarn *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)"
    ]
  }
}
